{
  "name": "plugin-catalog-service",
  "version": "1.0.0",
  "description": "Dueño del catálogo de plugins vendibles, sus dependencias y las activaciones por organización (Node + TypeScript + Hono + MySQL).",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all"
  },
  "dependencies": {
    "@facturero/outbox-relay": "^0.2.3",
    "@hono/node-server": "^1.19.14",
    "@hono/otel": "^1.2.0",
    "@hono/zod-validator": "^0.4.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-mysql2": "^0.67.0",
    "@opentelemetry/instrumentation-sequelize": "^0.14.0",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "amqplib": "^2.0.1",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "mysql2": "^3.11.5",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@types/node": "^22.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs"
}
