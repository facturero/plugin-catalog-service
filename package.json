{
  "name": "plugin-catalog-service",
  "version": "1.0.0",
  "description": "Dueño del catálogo de plugins vendibles, sus dependencias y las activaciones por organización (Node + TypeScript + Hono + MySQL).",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all"
  },
  "dependencies": {
    "@facturero/outbox-relay": "^0.2.2",
    "@hono/node-server": "^1.19.14",
    "@hono/zod-validator": "^0.4.1",
    "amqplib": "^2.0.1",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "mysql2": "^3.11.5",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs"
}
